{
  "name": "@promin/zorya-client",
  "version": "0.1.0",
  "description": "Zorya client SDK — connect worker processes + admin tools to a remote Zorya server.",
  "keywords": [
    "client",
    "sdk",
    "worker",
    "workflow",
    "zorya"
  ],
  "homepage": "https://github.com/spilne/promin/tree/main/packages/zorya-client",
