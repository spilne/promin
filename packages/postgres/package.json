{
  "name": "@promin/postgres",
  "version": "0.1.0",
  "description": "Postgres stores for promin — workflow storage, step queue, scheduling, agent and eval stores.",
  "keywords": [
    "postgres",
    "scheduler",
    "step-queue",
    "typescript",
    "workflow-storage"
  ],
  "homepage": "https://github.com/spilne/promin/tree/main/packages/postgres",
  "bugs": {
    "url": "https://github.com/spilne/promin/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/promin.git",
    "directory": "packages/postgres"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@promin/source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "@promin/source": "./src/testing.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@promin/agent": "workspace:*",
    "@promin/core": "workspace:*",
    "@promin/evals": "workspace:*",
    "@promin/workflow": "workspace:*",
    "@spilne/perfect-core": "catalog:",
    "@spilne/perfect-postgres": "catalog:",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.5",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "testcontainers": "^11.13.0"
  },
  "nx": {
    "targets": {
      "typecheck": {},
      "test": {},
      "lint": {},
      "format": {},
      "format-check": {},
      "ci": {},
      "publish": {}
    }
  }
}
