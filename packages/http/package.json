{
  "name": "@promin/http",
  "version": "0.9.0",
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@promin/source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/lib/client/index.d.ts",
      "@promin/source": "./src/lib/client/index.ts",
      "import": "./dist/lib/client/index.js",
      "default": "./dist/lib/client/index.js"
    },
    "./client/testing": {
      "types": "./dist/lib/client/testing.d.ts",
      "@promin/source": "./src/lib/client/testing.ts",
      "import": "./dist/lib/client/testing.js",
      "default": "./dist/lib/client/testing.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@promin/core": "workspace:*",
    "@promin/data": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "zod": "catalog:"
  },
  "nx": {
    "targets": {
      "typecheck": {},
      "test": {},
      "lint": {},
      "format": {},
      "format-check": {},
      "ci": {}
    }
  },
  "description": "Resilient HTTP client built on promin Pipeline \u2014 retry, polling, SSE, NDJSON streaming.",
  "license": "MIT",
  "keywords": [
    "typescript",
    "http-client",
    "retry",
    "polling",
    "sse",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/promin.git",
    "directory": "packages/http"
  },
  "homepage": "https://github.com/spilne/promin/tree/main/packages/http",
  "bugs": {
    "url": "https://github.com/spilne/promin/issues"
  }
}
