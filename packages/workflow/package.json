      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./distributed": {
      "types": "./dist/distributed.d.ts",
      "@promin/source": "./src/distributed.ts",
      "import": "./dist/distributed.js",
      "default": "./dist/distributed.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "@promin/source": "./src/scheduler.ts",
      "import": "./dist/scheduler.js",
      "default": "./dist/scheduler.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "@promin/source": "./src/discovery.ts",
      "import": "./dist/discovery.js",
      "default": "./dist/discovery.js"
    },
    "./sql-models": {
      "types": "./dist/sql-models.d.ts",
      "@promin/source": "./src/sql-models.ts",
      "import": "./dist/sql-models.js",
      "default": "./dist/sql-models.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "@promin/source": "./src/testing.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./storage-kit": {
      "types": "./dist/storage-kit.d.ts",
      "@promin/source": "./src/storage-kit.ts",
      "import": "./dist/storage-kit.js",
      "default": "./dist/storage-kit.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "@promin/source": "./src/dev.ts",
      "import": "./dist/dev.js",
      "default": "./dist/dev.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@spilne/perfect-core": "catalog:",
    "croner": "^10.0.1",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "nx": {
    "targets": {
      "typecheck": {},
      "test": {},
      "lint": {},
      "format": {},
      "format-check": {},
      "ci": {},
      "publish": {}
    }
  }
