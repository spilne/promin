{
  "name": "@promin/workflow",
  "version": "0.1.0",
  "description": "Durable workflow execution with DAG steps, compensation, distributed workers, and state machines.",
  "keywords": [
    "distributed",
    "durable-execution",
    "saga",
    "scheduler",
    "state-machine",
    "typescript",
    "workflow"
  ],
  "homepage": "https://github.com/spilne/promin/tree/main/packages/workflow",
  "bugs": {
    "url": "https://github.com/spilne/promin/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/promin.git",
    "directory": "packages/workflow"
  },
  "files": [
    "dist",
    "examples",
    "package.json",
    "versioning.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
