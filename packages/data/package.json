  "keywords": [
    "typescript",
    "dataframe",
    "analytics",
    "data-quality",
    "profiling",
    "lazy-evaluation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/spilne/promin.git",
    "directory": "packages/data"
  },
  "homepage": "https://github.com/spilne/promin/tree/main/packages/data",
  "bugs": {
    "url": "https://github.com/spilne/promin/issues"
  }
