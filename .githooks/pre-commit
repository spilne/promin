#!/bin/sh

export NX_INTERACTIVE=false
export CI=true

run_quiet() {
  label="$1"
  shift
  echo "$label"
  output=$("$@" 2>&1)
  status=$?
  if [ $status -ne 0 ]; then
    echo "$output"
    exit $status
  fi
}

# Remember which files are currently staged
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

run_quiet "Running format..." bun fmt

# Re-stage only files that were originally staged (in case formatter changed them)
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | xargs git add
fi

