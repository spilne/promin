#!/bin/sh

export NX_INTERACTIVE=false
export CI=true

run_quiet() {
  label="$1"
  shift
  echo "$label"
  output=$("$@" 2>&1)
  status=$?
  if [ $status -ne 0 ]; then
    echo "$output"
    exit $status
  fi
}

# Remember which files are currently staged (NUL-delimited so paths with
# spaces or newlines survive). Deleted paths are excluded: there is nothing
# on disk to re-stage.
STAGED_LIST=$(mktemp "${TMPDIR:-/tmp}/promin-pre-commit.XXXXXX") || exit 1
trap 'rm -f "$STAGED_LIST"' EXIT
git diff --cached --name-only -z --diff-filter=d >"$STAGED_LIST" || exit 1

run_quiet "Running format..." bun fmt

# Re-stage only files that were originally staged (in case the formatter
# changed them). Every path here is already in the index, so `-f` cannot
# pull in new untracked files; it only stops ignore rules — including
# per-user ones such as a global `docs` pattern matching
# documentation/content/docs — from making `git add` exit non-zero.
if [ -s "$STAGED_LIST" ]; then
  xargs -0 git add -f -- <"$STAGED_LIST" || {
    echo "pre-commit: failed to re-stage formatted files" >&2
    exit 1
  }
fi
