{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/ci.yml"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "include": [
        "packages/**/*",
        "examples"
      ],
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build"
        }
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "commands": [
          "tsc -b tsconfig.lib.json"
        ],
        "cwd": "{projectRoot}"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/bun.lock",
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        }
      ],
      "outputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "{projectRoot}/dist/**/*.d.ts.map",
        "{projectRoot}/dist/*.tsbuildinfo",
        "{projectRoot}/dist-examples/**/*.d.ts",
        "{projectRoot}/dist-examples/**/*.d.ts.map",
        "{projectRoot}/dist-examples/*.tsbuildinfo",
        "{projectRoot}/dist-spec/**/*.d.ts",
        "{projectRoot}/dist-spec/**/*.d.ts.map",
        "{projectRoot}/dist-spec/*.tsbuildinfo"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bun --conditions=@promin/source test --pass-with-no-tests"
        ],
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "oxlint -c .oxlintrc.json {projectRoot}"
        ],
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "oxfmt -c .oxfmtrc.json {projectRoot}"
        ],
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/.oxfmtrc.json"
      ]
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxfmt -c .oxfmtrc.check.json --check {projectRoot}",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/.oxfmtrc.check.json"
      ]
    },
    "ci": {
      "executor": "nx:noop",
      "dependsOn": [
        "typecheck",
        "lint",
        "format-check",
        "test",
        "^ci"
      ]
    }
  },
  "release": {
    "projects": [
      "packages/*"
    ],
    "projectsRelationship": "fixed",
    "releaseTagPattern": "v{version}",
    "version": {
      "currentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": false,
      "versionPrefix": "^",
      "versionActionsOptions": {
        "installIgnoreScripts": true
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": false,
        "renderOptions": {
          "authors": false
        }
      },
      "projectChangelogs": false
    },
    "git": {
      "commit": true,
      "tag": true,
      "push": false,
      "commitMessage": "chore(release): {version}"
    }
  }
}
