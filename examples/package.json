{
  "name": "@promin/examples",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "@promin/container": "workspace:*",
    "@promin/core": "workspace:*",
    "@promin/data": "workspace:*",
    "@promin/kafka": "workspace:*",
    "@promin/postgres": "workspace:*",
    "@promin/redis": "workspace:*",
    "@promin/topology": "workspace:*",
    "@promin/workflow": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit -p examples/tsconfig.json",
          "cwd": "{workspaceRoot}"
        }
      },
      "lint": {},
      "format": {},
      "format-check": {}
    }
  }
}
