{
  "name": "@promin/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "bunx nx run-many -t build",
    "typecheck": "bunx nx run-many -t typecheck",
    "lint": "bunx nx run-many -t lint",
    "lci": "bunx nx affected -t ci --base=origin/main",
    "test": "bun --conditions=@promin/source test packages/workflow packages/data packages/postgres packages/redis",
    "test:all": "bun --conditions=@promin/source test packages/",
    "fmt": "bunx nx run-many -t format",
    "ff": "bun run fmt",
    "format": "bun run fmt",
    "bench": "bun run benchmarks/cross-language/run-all.ts",
    "bench:promin": "bun run benchmarks/cross-language/bench-promin.ts",
    "bench:dataframe": "bun run packages/data/src/lib/dataframe/dataframe.bench.ts",
    "bench:workflow": "bun --conditions=@promin/source run packages/workflow/src/lib/durable/journaled-step.bench.ts",
    "bench:all": "bun run bench:dataframe && bun run bench:workflow && bun run bench",
    "zorya": "bun --conditions=@promin/source run packages/zorya/scripts/dev.ts",
    "zorya:build": "bun --conditions=@promin/source run packages/zorya/scripts/build-ui.ts",
    "demo": "bun --conditions=@promin/source run packages/zorya/examples/start-all.ts",
    "demo:server": "bun --conditions=@promin/source run packages/zorya/examples/demo.ts",
    "demo:worker": "bun --conditions=@promin/source run packages/zorya/examples/worker.ts",
    "demo:user-app": "bun --conditions=@promin/source run packages/zorya/examples/user-app.ts",
    "docs": "bun run --filter @promin/docs build",
    "docs:dev": "bun run --filter @promin/docs dev",
    "docs:serve": "bunx serve .target/docs -p 4002",
    "clean": "rm -rf node_modules packages/*/node_modules .nx/cache .nx/workspace-data .target packages/*/dist documentation/generator/.next documentation/generator/node_modules",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "private": true,
  "devDependencies": {
    "@nx/js": "21.4.1",
    "@types/bun": "^1.3.3",
    "mitata": "^1.0.34",
    "nx": "21.4.1",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "typescript": "~5.9.2"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "examples",
      "documentation/generator"
    ],
    "catalog": {
      "@spilne/perfect-core": "^0.3.0",
      "@spilne/perfect-postgres": "^0.3.0",
      "@spilne/perfect-redis": "^0.3.0",
      "@types/bun": "^1.3.3",
      "zod": "^3.24.1"
    }
  }
}
